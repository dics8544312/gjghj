# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321

# Error Logging Channel (ID канала куда отправлять ошибки)
ERROR_LOG_CHANNEL_ID=-1003981422645

# Backup Channel (ID канала куда отправлять резервные копии БД)
# Бэкапы будут отправляться автоматически каждые 6 часов
BACKUP_CHANNEL_ID=-1004318502148

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=math_tutor
DB_USER=postgres
DB_PASSWORD=your_password_here

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# OpenAI Proxy (если OpenAI заблокирован в вашей стране)
# Раскомментируйте и укажите ваш HTTP/HTTPS proxy
# OPENAI_PROXY=http://username:password@proxy-server:port
# Или для SOCKS5: socks5://username:password@proxy-server:port
# Пример: OPENAI_PROXY=http://user:pass@proxy.example.com:8080

# Application Settings
DEBUG=False
